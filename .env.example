# Valeurs de développement : copie ce fichier en .env pour lancer le serveur
# en local (npm run dev:server). En production, les vraies valeurs se saisissent
# dans Coolify, jamais dans le dépôt.

# L'adresse où l'app s'ouvre dans le navigateur : http://localhost:5173 avec
# Vite (npm run dev), http://localhost:3000 avec le serveur seul ou Docker.
# Google doit connaître <PUBLIC_URL>/auth/callback comme adresse de retour.
PUBLIC_URL=http://localhost:5173

# Le client OAuth de Google (console Google Cloud, « Identifiants »).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signe les sessions : 32 caractères au moins. La production refuse cette
# valeur ; la changer déconnecte tout le monde.
SESSION_SECRET=dev-seulement-signe-les-sessions-en-local

# La base de développement (dans .data/, ignoré par git et par Docker).
DATABASE_PATH=.data/timeoff.sqlite
